#!/usr/bin/env python3
"""Installed appbuilder CLI bootstrap.

Editable installs normally expose source packages through a .pth file. Some
platforms skip hidden .pth files, so recover the editable source path from
direct_url.json before importing the real CLI.
"""

from __future__ import annotations

import json
import sys
from importlib import metadata
from pathlib import Path
from urllib.parse import unquote, urlparse


def _editable_source_root() -> Path | None:
    try:
        direct_url = metadata.distribution("appbuilder").read_text("direct_url.json")
    except metadata.PackageNotFoundError:
        return None
    if not direct_url:
        return None
    data = json.loads(direct_url)
    if not data.get("dir_info", {}).get("editable"):
        return None
    url = data.get("url", "")
    parsed = urlparse(url)
    if parsed.scheme != "file":
        return None
    return Path(unquote(parsed.path)).resolve()


def _load_main():
    try:
        from appbuilder.cli import main

        return main
    except ModuleNotFoundError as exc:
        if exc.name != "appbuilder":
            raise
    source_root = _editable_source_root()
    if source_root is not None:
        sys.path.insert(0, str(source_root))
    from appbuilder.cli import main

    return main


if __name__ == "__main__":
    raise SystemExit(_load_main()())
