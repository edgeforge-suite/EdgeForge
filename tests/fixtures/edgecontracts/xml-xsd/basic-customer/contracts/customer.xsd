<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:edgeforge:examples:customer:v1"
           xmlns:tns="urn:edgeforge:examples:customer:v1"
           elementFormDefault="qualified">
  <xs:simpleType name="StatusCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="SUSPENDED"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="CustomerMessage" type="tns:CustomerMessageType"/>
  <xs:complexType name="CustomerMessageType">
    <xs:sequence>
      <xs:element name="customerId" type="xs:string"/>
      <xs:element name="age" type="xs:int" minOccurs="0"/>
      <xs:element name="balance" type="xs:decimal"/>
      <xs:element name="active" type="xs:boolean"/>
      <xs:element name="openedDate" type="xs:date"/>
      <xs:element name="lastUpdatedAt" type="xs:dateTime" minOccurs="0" nillable="true"/>
      <xs:element name="status" type="tns:StatusCode"/>
      <xs:element name="alias" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="sourceSystem" type="xs:string" use="required"/>
  </xs:complexType>
</xs:schema>
