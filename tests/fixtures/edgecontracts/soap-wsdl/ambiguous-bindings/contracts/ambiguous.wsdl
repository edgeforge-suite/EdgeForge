<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:edgeforge:examples:ambiguous"
    targetNamespace="urn:edgeforge:examples:ambiguous">
  <wsdl:types>
    <xs:schema targetNamespace="urn:edgeforge:examples:ambiguous">
      <xs:element name="Request" type="xs:string"/>
      <xs:element name="Response" type="xs:string"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="RequestMessage"><wsdl:part name="parameters" element="tns:Request"/></wsdl:message>
  <wsdl:message name="ResponseMessage"><wsdl:part name="parameters" element="tns:Response"/></wsdl:message>
  <wsdl:portType name="PortType">
    <wsdl:operation name="call">
      <wsdl:input message="tns:RequestMessage"/>
      <wsdl:output message="tns:ResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="BindingOne" type="tns:PortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="call"><soap:operation soapAction="urn:one"/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="BindingTwo" type="tns:PortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="call"><soap:operation soapAction="urn:two"/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="AmbiguousService">
    <wsdl:port name="PortOne" binding="tns:BindingOne"><soap:address location="https://example.invalid/one"/></wsdl:port>
    <wsdl:port name="PortTwo" binding="tns:BindingTwo"><soap:address location="https://example.invalid/two"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
