<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:edgeforge:examples:rpc"
    targetNamespace="urn:edgeforge:examples:rpc">
  <wsdl:types>
    <xs:schema targetNamespace="urn:edgeforge:examples:rpc">
      <xs:element name="Request" type="xs:string"/>
      <xs:element name="Response" type="xs:string"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="RequestMessage">
    <wsdl:part name="parameters" element="tns:Request"/>
  </wsdl:message>
  <wsdl:message name="ResponseMessage">
    <wsdl:part name="parameters" element="tns:Response"/>
  </wsdl:message>
  <wsdl:portType name="RpcPortType">
    <wsdl:operation name="call">
      <wsdl:input message="tns:RequestMessage"/>
      <wsdl:output message="tns:ResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="RpcBinding" type="tns:RpcPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="call">
      <soap:operation soapAction="urn:call" style="rpc"/>
      <wsdl:input><soap:body use="encoded"/></wsdl:input>
      <wsdl:output><soap:body use="encoded"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="RpcService">
    <wsdl:port name="RpcPort" binding="tns:RpcBinding">
      <soap:address location="https://example.invalid/rpc"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
